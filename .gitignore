# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual Environments
venv/
env/
ENV/
.venv/

# Flask / Web App specific (if you expand to a web app later)
instance/
.webassets-cache
.flaskenv

# IDEs and Editors (VS Code settings, local workspaces)
.vscode/
.idea/

# Operating System generated files
.DS_Store
Thumbs.db

# Environment variables / secrets (good practice to ignore local configs)
.env